FROM python:3.13-alpine

WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.116.1 uvicorn==0.35.0 psycopg2-binary==2.9.10 redis==6.2.0 python-docx==1.2.0 pypdf==6.14.2 cryptography==50.0.0

COPY dashboard ./dashboard
COPY core ./core
COPY project/prompts ./project/prompts

# The portal performs explicitly requested local extraction from a read-only NAS
# mount. Synology ACLs deny these files to nobody(65534); container/root remains
# constrained by read_only, no-new-privileges and the read-only /volume1 bind.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/api/health || exit 1

CMD ["uvicorn", "dashboard.app:app", "--host", "0.0.0.0", "--port", "8080"]
