#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$PROJECT_ROOT"

show_help() {
    printf '%s\n' ""
    printf '%s\n' "CORE CLI"
    printf '%s\n' ""
    printf '%s\n' "Usage:"
    printf '%s\n' "  core doctor"
    printf '%s\n' "  core docs generate"
    printf '%s\n' "  core docs serve"
    printf '%s\n' "  core docs build"
    printf '%s\n' "  core docs open"
    printf '%s\n' "  core docs deploy"
    printf '%s\n' "  core project analyze"
    printf '%s\n' "  core project export"
    printf '%s\n' "  core jira auth"
    printf '%s\n' "  core jira epics --project SCRUM --dry-run"
    printf '%s\n' "  core jira stories --project SCRUM --dry-run"
    printf '%s\n' "  core jira sync --project SCRUM --dry-run"
    printf '%s\n' "  core cleanup assess"
    printf '%s\n' "  core cleanup legacy-duplicates --dry-run"
    printf '%s\n' "  core cleanup legacy-duplicates --apply --confirm-delete-legacy-duplicates"
    printf '%s\n' "  core cleanup migration-inventory --source PATH --dry-run"
    printf '%s\n' "  core cleanup migration-review --manifest latest --dry-run"
    printf '%s\n' "  core cleanup migration-proposal --manifest latest --dry-run"
    printf '%s\n' "  core runtime status"
    printf '%s\n' "  core runtime health"
    printf '%s\n' "  core runtime logs"
    printf '%s\n' "  core runtime dlq"
    printf '%s\n' "  core runtime cleanlocks"
    printf '%s\n' "  core runtime watch"
    printf '%s\n' "  core runtime start"
    printf '%s\n' "  core runtime stop"
    printf '%s\n' "  core runtime restart"
    printf '%s\n' "  core scanner full"
    printf '%s\n' "  core git pull  (run from Windows PowerShell)"
    printf '%s\n' "  core version"
    printf '%s\n' ""
}

command_domain="${1:-}"
command_action="${2:-}"

case "$command_domain" in
    doctor)
        python3 -m core.cli doctor
        ;;
    docs)
        case "$command_action" in
            generate)
                ./gendocs
                ;;
            serve|build)
                python3 -m core.cli docs "$command_action"
                ;;
            open)
                echo "Permanent Wiki: http://192.168.68.105:8000/wiki/"
                ;;
            deploy)
                docker compose build docs
                docker compose up -d --force-recreate docs
                docker compose ps docs
                ;;
            *)
                echo "Unknown docs command."
                echo "Use: core docs generate | serve | build | open | deploy"
                exit 1
                ;;
        esac
        ;;
    project)
        case "$command_action" in
            analyze)
                ./genproject
                ;;
            export)
                ./genproject
                echo ""
                echo "Exports generated in project/exports"
                ;;
            *)
                echo "Unknown project command."
                echo "Use: core project analyze | export"
                exit 1
                ;;
        esac
        ;;
    jira)
        shift
        python3 -m core.cli jira "$@"
        ;;
    cleanup)
        case "$command_action" in
            assess)
                sh ./tools/runtime/legacy-assessment
                ;;
            legacy-duplicates)
                shift 2
                sh ./tools/runtime/legacy-duplicates "$@"
                ;;
            migration-inventory)
                shift 2
                sh ./tools/runtime/migration-inventory "$@"
                ;;
            migration-review)
                shift 2
                sh ./tools/runtime/migration-review "$@"
                ;;
            migration-proposal)
                shift 2
                sh ./tools/runtime/migration-proposal "$@"
                ;;
            *)
                echo "Unknown cleanup command."
                echo "Use: core cleanup assess | legacy-duplicates ... | migration-inventory --source PATH --dry-run"
                exit 1
                ;;
        esac
        ;;
    runtime)
        case "$command_action" in
            status)
                ./tools/runtime/status
                ;;
            health)
                ./tools/runtime/health
                ;;
            logs)
                ./tools/runtime/logs
                ;;
            dlq)
                sh ./tools/runtime/dlq
                ;;
            cleanlocks)
                ./tools/runtime/cleanlocks
                ;;
            watch)
                ./tools/runtime/watch
                ;;
            start)
                docker compose up -d
                ;;
            stop)
                docker compose down
                ;;
            restart)
                docker compose down && docker compose up -d
                ;;
            *)
                echo "Unknown runtime command."
                echo "Use: core runtime status | health | logs | dlq | cleanlocks | watch | start | stop | restart"
                exit 1
                ;;
        esac
        ;;
    scanner)
        case "$command_action" in
            full)
                sh ./tools/runtime/scanner-full
                ;;
            *)
                echo "Unknown scanner command."
                echo "Use: core scanner full"
                exit 1
                ;;
        esac
        ;;
    git)
        case "$command_action" in
            pull)
                sh ./tools/runtime/git-pull
                ;;
            *)
                echo "Unknown git command."
                echo "Use: core git pull"
                exit 1
                ;;
        esac
        ;;
    version)
        if [ -f version.json ]; then
            cat version.json
        else
            echo "version.json not found"
            exit 1
        fi
        ;;
    *)
        show_help
        ;;
esac
