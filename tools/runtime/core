#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$PROJECT_ROOT"

DOCKER_BIN="${DOCKER_BIN:-docker}"
if ! command -v "$DOCKER_BIN" >/dev/null 2>&1 && [ -x /usr/local/bin/docker ]; then
    DOCKER_BIN=/usr/local/bin/docker
fi

show_help() {
    printf '%s\n' ""
    printf '%s\n' "CORE CLI"
    printf '%s\n' ""
    printf '%s\n' "Usage:"
    printf '%s\n' "  core doctor"
    printf '%s\n' "  core docs generate"
    printf '%s\n' "  core docs dev"
    printf '%s\n' "  core docs serve"
    printf '%s\n' "  core docs build"
    printf '%s\n' "  core docs open"
    printf '%s\n' "  core docs deploy"
    printf '%s\n' "  core dashboard deploy"
    printf '%s\n' "  core dashboard status"
    printf '%s\n' "  core dashboard open"
    printf '%s\n' "  core project analyze"
    printf '%s\n' "  core project export"
    printf '%s\n' "  core jira auth"
    printf '%s\n' "  core jira epics --project SCRUM --dry-run"
    printf '%s\n' "  core jira stories --project SCRUM --dry-run"
    printf '%s\n' "  core jira sync --project SCRUM --dry-run"
    printf '%s\n' "  core cleanup assess"
    printf '%s\n' "  core cleanup legacy-duplicates --dry-run"
    printf '%s\n' "  core cleanup legacy-duplicates --apply --confirm-delete-legacy-duplicates"
    printf '%s\n' "  core cleanup migration-inventory --source PATH --dry-run"
    printf '%s\n' "  core cleanup migration-review --manifest latest --dry-run"
    printf '%s\n' "  core cleanup migration-proposal --manifest latest --dry-run"
    printf '%s\n' "  core cleanup copy-plan --manifest latest --dry-run"
    printf '%s\n' "  core cleanup golden-records --source PATH --dry-run"
    printf '%s\n' "  core cleanup classification-inventory --source PATH --dry-run"
    printf '%s\n' "  core cleanup classification-extract --manifest latest --dry-run"
    printf '%s\n' "  core cleanup classification-plan --results latest --dry-run"
    printf '%s\n' "  core cleanup retention-plan --results latest --dry-run"
    printf '%s\n' "  core cleanup onedrive-baseline --source PATH --dry-run"
    printf '%s\n' "  core semantic onedrive-golden-pilot --cutoff TIMESTAMP --dry-run"
    printf '%s\n' "  core semantic pilot-extract MANIFEST_JSON"
    printf '%s\n' "  core semantic pilot-chunks MANIFEST_JSON"
    printf '%s\n' "  core semantic acc-metadata MANIFEST_JSON --dry-run|--apply"
    printf '%s\n' "  core semantic model-fetch"
    printf '%s\n' "  core semantic embedding-benchmark MANIFEST_JSON [--max-chunks N] [--batch-size N]"
    printf '%s\n' "  core runtime status"
    printf '%s\n' "  core runtime health"
    printf '%s\n' "  core runtime logs"
    printf '%s\n' "  core runtime dlq"
    printf '%s\n' "  core runtime cleanlocks"
    printf '%s\n' "  core runtime watch"
    printf '%s\n' "  core runtime start"
    printf '%s\n' "  core runtime stop"
    printf '%s\n' "  core runtime restart"
    printf '%s\n' "  core scanner full"
    printf '%s\n' "  core scanner hash-backfill --source PATH"
    printf '%s\n' "  core git pull  (run from Windows PowerShell)"
    printf '%s\n' "  core version"
    printf '%s\n' ""
}

command_domain="${1:-}"
command_action="${2:-}"

case "$command_domain" in
    doctor)
        python3 -m core.cli doctor
        ;;
    docs)
        case "$command_action" in
            generate)
                ./gendocs
                ;;
            dev)
                python3 -m core.cli docs serve
                ;;
            serve)
                "$DOCKER_BIN" compose up -d docs
                "$DOCKER_BIN" compose ps docs
                echo "Permanent Wiki: http://192.168.68.105:8000/wiki/"
                ;;
            build)
                python3 -m core.cli docs "$command_action"
                ;;
            open)
                echo "Permanent Wiki: http://192.168.68.105:8000/wiki/"
                ;;
            deploy)
                "$DOCKER_BIN" compose build docs
                "$DOCKER_BIN" compose up -d --force-recreate docs
                "$DOCKER_BIN" compose ps docs
                ;;
            *)
                echo "Unknown docs command."
                echo "Use: core docs generate | dev | serve | build | open | deploy"
                exit 1
                ;;
        esac
        ;;
    dashboard)
        case "$command_action" in
            deploy)
                "$DOCKER_BIN" compose build dashboard
                "$DOCKER_BIN" compose up -d --force-recreate dashboard
                "$DOCKER_BIN" compose ps dashboard
                echo "CORE Pulse: http://192.168.68.105:8080/coredashboard"
                ;;
            status)
                "$DOCKER_BIN" compose ps dashboard
                ;;
            open)
                echo "CORE Pulse: http://192.168.68.105:8080/coredashboard"
                ;;
            *)
                echo "Unknown dashboard command."
                echo "Use: core dashboard deploy | status | open"
                exit 1
                ;;
        esac
        ;;
    project)
        case "$command_action" in
            analyze)
                ./genproject
                ;;
            export)
                ./genproject
                echo ""
                echo "Exports generated in project/exports"
                ;;
            *)
                echo "Unknown project command."
                echo "Use: core project analyze | export"
                exit 1
                ;;
        esac
        ;;
    jira)
        shift
        python3 -m core.cli jira "$@"
        ;;
    cleanup)
        case "$command_action" in
            assess)
                sh ./tools/runtime/legacy-assessment
                ;;
            legacy-duplicates)
                shift 2
                sh ./tools/runtime/legacy-duplicates "$@"
                ;;
            migration-inventory)
                shift 2
                sh ./tools/runtime/migration-inventory "$@"
                ;;
            migration-review)
                shift 2
                sh ./tools/runtime/migration-review "$@"
                ;;
            migration-proposal)
                shift 2
                sh ./tools/runtime/migration-proposal "$@"
                ;;
            copy-plan)
                shift 2
                sh ./tools/runtime/copy-plan "$@"
                ;;
            golden-records)
                shift 2
                sh ./tools/runtime/golden-records "$@"
                ;;
            classification-inventory)
                shift 2
                sh ./tools/runtime/classification-inventory "$@"
                ;;
            classification-extract)
                shift 2
                sh ./tools/runtime/classification-extract "$@"
                ;;
            classification-plan)
                shift 2
                sh ./tools/runtime/classification-plan "$@"
                ;;
            retention-plan)
                shift 2
                sh ./tools/runtime/retention-plan "$@"
                ;;
            onedrive-baseline)
                shift 2
                sh ./tools/runtime/onedrive-baseline "$@"
                ;;
            *)
                echo "Unknown cleanup command."
                echo "Use: core cleanup assess | legacy-duplicates ... | migration-inventory ... | onedrive-baseline --source PATH --dry-run"
                exit 1
                ;;
        esac
        ;;
    semantic)
        case "$command_action" in
            onedrive-golden-pilot)
                shift 2
                sh ./tools/runtime/semantic-pilot "$@"
                ;;
            pilot-extract)
                shift 2
                sh ./tools/semantic/pilot-extract "$@"
                ;;
            pilot-chunks)
                shift 2
                sh ./tools/semantic/pilot-chunks "$@"
                ;;
            acc-metadata)
                shift 2
                sh ./tools/runtime/semantic-acc-metadata "$@"
                ;;
            model-fetch)
                sh ./tools/semantic/model-fetch
                ;;
            embedding-benchmark)
                shift 2
                sh ./tools/semantic/embedding-benchmark "$@"
                ;;
            *)
                echo "Unknown semantic command."
                echo "Use: core semantic onedrive-golden-pilot ... | pilot-extract MANIFEST_JSON | pilot-chunks MANIFEST_JSON | acc-metadata MANIFEST_JSON --dry-run|--apply | model-fetch | embedding-benchmark MANIFEST_JSON"
                exit 1
                ;;
        esac
        ;;
    runtime)
        case "$command_action" in
            status)
                ./tools/runtime/status
                ;;
            health)
                ./tools/runtime/health
                ;;
            logs)
                ./tools/runtime/logs
                ;;
            dlq)
                sh ./tools/runtime/dlq
                ;;
            cleanlocks)
                ./tools/runtime/cleanlocks
                ;;
            watch)
                ./tools/runtime/watch
                ;;
            start)
                "$DOCKER_BIN" compose up -d
                ;;
            stop)
                "$DOCKER_BIN" compose down
                ;;
            restart)
                "$DOCKER_BIN" compose down && "$DOCKER_BIN" compose up -d
                ;;
            *)
                echo "Unknown runtime command."
                echo "Use: core runtime status | health | logs | dlq | cleanlocks | watch | start | stop | restart"
                exit 1
                ;;
        esac
        ;;
    scanner)
        case "$command_action" in
            full)
                sh ./tools/runtime/scanner-full
                ;;
            hash-backfill)
                shift 2
                sh ./tools/runtime/scanner-hash-backfill "$@"
                ;;
            *)
                echo "Unknown scanner command."
                echo "Use: core scanner full | hash-backfill --source PATH"
                exit 1
                ;;
        esac
        ;;
    git)
        case "$command_action" in
            pull)
                sh ./tools/runtime/git-pull
                ;;
            *)
                echo "Unknown git command."
                echo "Use: core git pull"
                exit 1
                ;;
        esac
        ;;
    version)
        if [ -f version.json ]; then
            cat version.json
        else
            echo "version.json not found"
            exit 1
        fi
        ;;
    *)
        show_help
        ;;
esac
