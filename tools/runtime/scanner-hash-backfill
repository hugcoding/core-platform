#!/bin/sh
set -eu

REDIS_CONTAINER=${REDIS_CONTAINER:-nas-redis-1}
REQUEST_KEY=scanner:request:hash_backfill
source_path=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --source)
            source_path=${2:-}
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

case "$source_path" in
    /volume1/*) ;;
    *)
        echo "Source must be an absolute path below /volume1." >&2
        exit 2
        ;;
esac

if ! docker exec "$REDIS_CONTAINER" redis-cli EXISTS scanner:heartbeat | grep -q '^1$'; then
    echo "Scanner heartbeat is missing; hash backfill was not requested." >&2
    exit 1
fi

result=$(docker exec "$REDIS_CONTAINER" redis-cli SET "$REQUEST_KEY" "$source_path" NX)
if [ "$result" = "OK" ]; then
    echo "Document hash backfill requested for: $source_path"
    echo "Follow with: docker compose logs -f scanner metadata_worker"
else
    echo "A document hash backfill request is already pending."
fi
