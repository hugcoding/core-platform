FROM python:3.13-alpine AS builder

ARG MKDOCS_MATERIAL_VERSION=9.7.7

WORKDIR /build
RUN pip install --no-cache-dir "mkdocs-material==${MKDOCS_MATERIAL_VERSION}"

COPY mkdocs.yml .
COPY docs ./docs
RUN mkdocs build --clean

FROM nginx:1.27-alpine

COPY tools/docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/site /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/wiki/ || exit 1
